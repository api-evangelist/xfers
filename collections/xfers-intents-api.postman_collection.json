                  "key": "key",
                  "value": "X-XFERS-USER-API-KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"<float>\",\n  \"currency\": \"<string>\",\n  \"request_id\": \"<string>\",\n  \"bank\": \"<string>\",\n  \"notify_url\": \"<string>\",\n  \"disable_va\": \"false\"\n}",
