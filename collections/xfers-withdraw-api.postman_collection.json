              "body": "{\n  \"available_balance\": 68596,\n  \"ledger_balance\": 68596,\n  \"withdrawal_request\": {\n    \"id\": \"contract_d3b5b84ba7814eb28ed4f9845d65e53a\",\n    \"idempotency_id\": \"Order_12346\",\n    \"type\": \"Sobatku/withdrawal\",\n    \"status\": \"pending\",\n    \"amount\": \"110000.0\",\n    \"fees\": \"0.0\",\n    \"account_no\": \"1680366060\",\n    \"bank_abbrev\": \"BCA\",\n    \"express\": true,\n    \"value_date\": null,\n    \"failure_reason\": null,\n    \"created_at\": \"2018-12-05T11:15:37+07:00\"\n  }\n}",
