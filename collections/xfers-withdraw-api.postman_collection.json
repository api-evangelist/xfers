      "id": "0bf1aabd-cfcc-457f-a7e3-41d98a593a8c",
      "name": "Withdraw",
      "description": {
        "content": "API for Withdrawal",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7a56a207-592c-4f7e-8c3b-4cea7d837dff",
          "name": "Create Withdrawal",
          "request": {
            "name": "Create Withdrawal",
            "description": {
              "content": "Withdrawal Time varies upon country. \r\nFor Indonesia, withdrawal time is instantaneous.\r\nFor Singapore, withdrawal time depends on whether it is an express withdrawal.\r\n\r\n#### Withdrawal on Behalf\r\nIf you wish to withdraw to a bank account that does not belong to you, add in user_api_token in the params.\r\n\r\nBehind the scenes, Xfers does a payout of funds from your Xfers account to that user’s Xfers account, followed by a withdrawal. This is required for compliance purposes as we cannot directly withdraw funds to a bank account that does not belong to you.\r\n\r\nTo clarify this:\r\n\r\nPlacing of xfers_api_token | Flow | Remark\r\n--------------- |  ----------- | -----\r\nmerchant's token in header, user's token in body| merchant's Xfers account -> user's Xfers account -> user's bank Account | We call this `Withdrawal on Behalf`\r\nuser's token in header, nothing in body| user's Xfers account -> user's bank Account | This is the standard Withdrawal usage\r\nmerchant's token in header, nothing in body| merchant's Xfers account -> merchant's bank Account | This is usually done via Xfers Dashboard\r\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "user",
                "bank_account",
                ":bank_account_id",
                "withdraw"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "bank_account_id",
                  "description": "(Required) The ID of the bank account. You can retrieve this from in the response of Create Bank Account and List Bank Account API"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-XFERS-USER-API-KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "amount",
                  "value": "<string>",
                  "description": "(Required) Transaction Amount"
                },
                {
                  "disabled": false,
                  "key": "idempotency_id",
                  "value": "<string>",
                  "description": "(Required) Unique ref no provided by you to prevent double transaction, this cannot be repeated, Currently only activated for Indonesia"
                },
                {
                  "disabled": false,
                  "key": "express",
                  "value": "false",
                  "description": "Only Singapore.\n\nExpress Withdrawal has fees but will arrive at recipient bank within 24 hrs.\nStandard withdrawal is free but takes 2-3 business day to arrive at recipient bank.\nDefaults to false"
                },
                {
                  "disabled": false,
                  "key": "user_api_token",
                  "value": "<string>",
                  "description": "Use this param if you want to withdraw to another user’s bank account instead of your own."
                }
              ]
            }
          },
          "response": [
            {
              "id": "d2e8d63a-4428-49fe-a650-825c9b50dba6",
              "name": "Success",
              "originalRequest": {
                "url": {
