                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Transaction Amount",
                        "type": "text/plain"
                      },
                      "key": "amount",
                      "value": "1200000"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Unique ref no provided by you to prevent double transaction, this cannot be repeated, Currently only activated for Indonesia",
                        "type": "text/plain"
                      },
