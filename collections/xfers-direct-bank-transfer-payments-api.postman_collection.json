          "id": "71343a2a-e5d6-44f4-8439-e5f60ef18d01",
          "name": "Create Direct Bank Transfer Payment",
          "request": {
            "name": "Create Direct Bank Transfer Payment",
            "description": {
              "content": "The following API will allow you to make a Direct Bank Transfer Payment request. Using Direct Bank Transfer has the advantage of having higher transaction limits as compared to normal Charge which uses your wallet balance (`/charges`). The API token used in `X-XFERS-USER-API-KEY` header should be your customer's API token.\r\n \r\nMerchants need to create a Direct Bank Transfer Payment request first. After receiving successful response from above API, please follow instruction in http://docs.xfers.io/Singapore#operation/getTransferInfo to get bank account details.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "api",
                "v3",
                "user",
                "direct_bank_transfer_payments"
              ],
              "host": [
                "www",
                "xfers",
                "io"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-XFERS-USER-API-KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"<float>\",\n  \"external_id\": \"<string>\",\n  \"callback_url\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
